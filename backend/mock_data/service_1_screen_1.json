{
  "id": "screen_1",
  "header": "Welcome to Service 1",
  "content": "Please enter your details to proceed.",
  "components": [
    {
      "id": "name_input",
      "type": "text",
      "label": "Full Name",
      "placeholder": "John Doe",
      "validations": [
        {
          "type": "required",
          "message": "Name is required"
        }
      ]
    },
    {
      "id": "country_input",
      "type": "combobox",
      "label": "Country",
      "restMetadata": {
        "endpoint": "/api/data/countries",
        "method": "GET"
      },
      "validations": [
        {
          "type": "required",
          "message": "Country is required"
        }
      ]
    },
    {
      "id": "radio_field",
      "type": "radio",
      "label": "Radio Field",
      "options": [
        {
          "label": "Option A",
          "value": "A"
        },
        {
          "label": "Option B",
          "value": "B"
        }
      ],
      "validations": [
        {
          "type": "required"
        }
      ]
    }
  ],
  "buttons": [
    {
      "id": "next_btn",
      "label": "Next",
      "action": "next_step",
      "color": "primary"
    }
  ]
}