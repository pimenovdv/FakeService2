{
  "id": "screen_1",
  "header": "Welcome to Service 1",
  "content": "Please enter your details to proceed.",
  "components": [
    {
      "id": "name_input",
      "type": "text",
      "label": "Full Name",
      "placeholder": "John Doe",
      "validations": [
        {
          "type": "required",
          "message": "Name is required"
        }
      ]
    },
    {
      "id": "country_input",
      "type": "combobox",
      "label": "Country",
      "restMetadata": {
        "endpoint": "/api/data/countries",
        "method": "GET"
      },
      "validations": [
        {
          "type": "required",
          "message": "Country is required"
        }
      ]
    },
    {
      "id": "city_input",
      "type": "text",
      "label": "City",
      "showConditions": [
        {
          "dependsOn": "country_input",
          "operator": "===",
          "value": "usa"
        }
      ]
    }
  ],
  "buttons": [
    {
      "id": "next_btn",
      "label": "Next",
      "action": "next_step",
      "color": "primary"
    }
  ]
}
